# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Only public values go here (the anon / publishable key). Server secrets live in Supabase secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key
# Cloudflare Turnstile site key. This is Cloudflare's public test key (always passes); use your own in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
